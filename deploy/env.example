# cp deploy/env.example deploy/.env  and fill the two keys.
# NOTE: Chainlit does not call load_dotenv(); run.sh sources this file itself.

OPENAI_API_KEY=sk-...
TAVILY_API_KEY=tvly-...

OPENAI_MODEL=gpt-5.6-luna
SEARCH_API=tavily              # duckduckgo works without a key but rate-limits

# DToR shape — start small, raise once you have a cost datapoint
MAX_BRANCHES=3
MAX_BRANCH_DEPTH=2
MAX_WEB_RESEARCH_LOOPS=2

# NODES_PER_BRANCH: keep >= 10. A branch whose budget hits exactly 0 while
# another branch still has pending work deadlocks the router (verified;
# see "Known limits" in README). 20 is safe, 2 reproducibly hangs.
NODES_PER_BRANCH=20
FETCH_FULL_PAGE=False

CHAINLIT_HOST=127.0.0.1
CHAINLIT_PORT=8000
PHOENIX_PORT=6006
